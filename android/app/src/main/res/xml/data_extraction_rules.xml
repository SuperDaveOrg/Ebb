<?xml version="1.0" encoding="utf-8"?>
<!--
  Excludes Ebb from Android's cloud backup and device-to-device transfer.

  This is not about hiding anything. It is that "your data stays on this phone"
  has to be literally true: if Android silently copied the database into the
  user's Google Drive backup, the promise on the About screen would be false.
  The user can still take an explicit backup from Settings whenever she wants.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
