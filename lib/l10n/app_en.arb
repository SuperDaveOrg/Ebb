  "settingsDataHeadline": "Your cycle is your business.",
  "@settingsDataHeadline": {
    "description": "Heading of the \"Your data\" screen. Warm, ordinary, not secretive."
  },
  "settingsDataLede": "Ebb is built so that the question \"what do they do with my data?\" has a boring answer: nothing, because we never receive it.",
  "settingsDataTradeOff": "One trade-off worth knowing: because there is no cloud backup, a lost or wiped phone means lost history. If that matters to you, save a backup file from Settings now and then, and keep it somewhere other than this phone.",
  "settingsWhereDataLives": "Where your data lives",
  "settingsWhereDataLivesHint": "Your data, and who can see it.",
  "settingsDataStaysTitle": "It stays on your phone",
  "settingsDataStaysBody": "Everything you log is written to a database on this device. There is no account to create and no server to sync with. It only goes anywhere else if you move it yourself — a backup file, or another phone you send it to.",
  "@settingsDataStaysBody": {
    "description": "One point on the \"Your data\" screen, which says plainly where the data lives. Calm and matter-of-fact; tracking a cycle is ordinary."
  },
  "settingsDataUnseenTitle": "We cannot see it",
  "settingsDataUnseenBody": "Ebb is built without permission to use the internet at all. Android enforces that, and you can verify it yourself in the app's permission list.",
  "@settingsDataUnseenBody": {
    "description": "One point on the \"Your data\" screen, which says plainly where the data lives. Calm and matter-of-fact; tracking a cycle is ordinary."
  },
  "settingsDataPermissionsTitle": "What the permissions are for",
  "settingsDataPermissionsBody": "Notifications, for reminders. Camera, only while you receive history from another phone — it reads the codes and nothing is recorded or kept. Ebb also re-arms your reminders when the phone restarts. That is the whole list.",
  "@settingsDataPermissionsBody": {
    "description": "One point on the \"Your data\" screen, which says plainly where the data lives. Calm and matter-of-fact; tracking a cycle is ordinary."
  },
  "settingsDataNotForSaleTitle": "There is nothing to sell",
  "settingsDataNotForSaleBody": "No analytics, no advertising, no third-party libraries phoning home. Since your data never reaches us, there is no copy of it for anyone to buy, subpoena, or leak.",
  "@settingsDataNotForSaleBody": {
    "description": "One point on the \"Your data\" screen, which says plainly where the data lives. Calm and matter-of-fact; tracking a cycle is ordinary."
  },
  "settingsDataEraseTitle": "You can erase it instantly",
  "settingsDataEraseBody": "Deleting your data in Settings, or uninstalling Ebb, removes everything Ebb holds. Ebb keeps no other copy — the only ones are backup files you saved or phones you sent it to yourself.",
  "@settingsDataEraseBody": {
    "description": "One point on the \"Your data\" screen, which says plainly where the data lives. Calm and matter-of-fact; tracking a cycle is ordinary."
  },
  "settingsDataOpenSourceTitle": "You can check our work",
  "settingsDataOpenSourceBody": "Ebb is open source under the GNU General Public License. Anyone can read exactly what it does, and the published builds are made from that same code.",
  "@settingsDataOpenSourceBody": {
    "description": "One point on the \"Your data\" screen, which says plainly where the data lives. Calm and matter-of-fact; tracking a cycle is ordinary."
  },
  "settingsHelpLoggingTitle": "Logging a period",
  "settingsHelpLoggingBody": "Tap “My period started today” on the first day of bleeding, and “My period ended today” on the last.\n\nForgot to log it? Use “It started on an earlier day” instead. Any past period can be added or corrected in History (the clock icon): tap one to change its dates or add a note.\n\nIf no end is logged within two weeks, Ebb stops treating the period as still going and offers to add the end instead.",
  "@settingsHelpLoggingBody": {
    "description": "A topic on the \"How Ebb works\" help screen. Words in quotation marks name buttons and settings elsewhere in the app: use exactly the same translation as those."
  },
  "settingsHelpEstimateTitle": "How the estimate works",
  "settingsHelpEstimateBody": "Ebb looks at the gaps between the starts of your recent periods — up to the last six.\n\nWith only a little history it leans on a typical 28-day cycle, and says so. The more you log, the more the estimate is your own rhythm.\n\nIt shows a range rather than a single date, and tells you how sure it is. If your cycles vary a lot, the range is wider.\n\nIf a period is late, Ebb says how late. If nothing is logged for nearly two cycles, it assumes a period went unlogged, estimates from there, and says so. History points out long gaps, and adding a missed period puts the estimate right.",
  "@settingsHelpEstimateBody": {
    "description": "A topic on the \"How Ebb works\" help screen. Words in quotation marks name buttons and settings elsewhere in the app: use exactly the same translation as those."
  },
  "settingsHelpExcludeTitle": "A cycle that shouldn’t count",
  "settingsHelpExcludeBody": "Illness, a medication change or a pregnancy loss can throw one cycle right off, and it would pull the estimate with it.\n\nIn History, tap that period and turn off “Count this cycle in predictions”. It stays in your history; the estimate just ignores it. Add a note there too, so you remember why.",
  "@settingsHelpExcludeBody": {
    "description": "A topic on the \"How Ebb works\" help screen. Words in quotation marks name buttons and settings elsewhere in the app: use exactly the same translation as those."
  },
  "settingsHelpGroupsTitle": "Groups",
  "settingsHelpGroupsBody": "For circles and clubs that track together. Turn them on in Settings → Advanced, then make a group and choose who’s in it. “See … together” in the list of people shows everyone side by side, with the moon.\n\nA group can have two kinds of member. Someone added to it is tracked on this phone, and you log for them here. Someone imported keeps tracking on their own phone and provides their history to the group: it stays theirs, and can’t be changed on anyone else’s phone.\n\nTo be imported, send just your history (Settings → Send to another phone) — as much or as little as you like, with or without your daily notes. The other phone imports it from the group: Manage groups → the group → Import from their phone. Importing you again brings it up to date.\n\nImported history belongs to its group. Taking someone imported out of their last group, or deleting that group, takes their history off the phone too. And it can’t be sent on: only your own history can.",
  "@settingsHelpGroupsBody": {
    "description": "A topic on the \"How Ebb works\" help screen. Words in quotation marks name buttons and settings elsewhere in the app: use exactly the same translation as those."
  },
  "settingsHelpRatingsTitle": "Day ratings, feelings and charts",
  "settingsHelpRatingsBody": "Tap any day on the calendar to rate it from 1 to 5, and to pick a face for how you felt. Both are optional; tap a choice again to clear it.\n\nCharts (the chart icon) shows each day’s rating over the dates you choose, with periods shaded, and which feelings came during and before periods. With moon phases turned on in Settings, the moon is there too.\n\nThe charts show what you logged. They don’t say what it means — that’s yours to judge.",
  "@settingsHelpRatingsBody": {
    "description": "A topic on the \"How Ebb works\" help screen. Words in quotation marks name buttons and settings elsewhere in the app: use exactly the same translation as those."
  },
  "settingsHelpTemperatureTitle": "Temperature and cervical mucus",
  "settingsHelpTemperatureBody": "Turn on “Track temperature and cervical mucus” in Settings, and each day on the calendar has room for your waking temperature and how cervical mucus felt and looked. If something may have thrown a reading off — illness, little sleep, alcohol, taking it late — tick the box under it.\n\nCharts shows the temperatures as a line, with mucus underneath and periods shaded, in °C or °F (Settings).\n\nEbb records and draws these, and that’s all. It doesn’t look for a rise or work out fertile days from them, and its fertile-window estimate still comes from cycle timing alone. If you follow a method such as the sympto-thermal method, the chart is there for you to read by its rules.",
  "@settingsHelpTemperatureBody": {
    "description": "A topic on the \"How Ebb works\" help screen. Words in quotation marks name buttons and settings elsewhere in the app: use exactly the same translation as those."
  },
  "settingsHelpRemindersTitle": "Reminders",
  "settingsHelpRemindersBody": "A heads-up a few days before your period is expected, and another on the day. Choose how far ahead in Settings.\n\nThey’re scheduled on the phone itself, so they arrive with no signal and in airplane mode.\n\nEbb sets them each time you open it, from the latest estimate. The phone keeps them through restarts, but Ebb can’t update them while it’s closed, so open it now and then — logging a period is enough.\n\nAndroid may deliver them a little after the usual time to save battery. If Ebb is force-stopped, or a battery saver restricts it, they may not arrive until you next open Ebb.",
  "@settingsHelpRemindersBody": {
    "description": "A topic on the \"How Ebb works\" help screen. Words in quotation marks name buttons and settings elsewhere in the app: use exactly the same translation as those."
  },
  "settingsHelpFertileTitle": "The fertile window",
  "settingsHelpFertileBody": "Off unless you turn it on in Settings. It’s estimated from cycle timing alone, which is not reliable enough to use as contraception.",
  "@settingsHelpFertileBody": {
    "description": "A topic on the \"How Ebb works\" help screen. Words in quotation marks name buttons and settings elsewhere in the app: use exactly the same translation as those."
  },
  "settingsHelpBackupTitle": "Backing up",
  "settingsHelpBackupBody": "There’s no cloud copy of your history, so a lost or wiped phone means lost history.\n\nSettings → “Back up to a file” saves everything as a file, wherever you choose. Keep it somewhere other than this phone. “Restore from a backup” brings it back.",
  "@settingsHelpBackupBody": {
    "description": "A topic on the \"How Ebb works\" help screen. Words in quotation marks name buttons and settings elsewhere in the app: use exactly the same translation as those."
  },
  "settingsHelpMovingTitle": "Moving to a new phone",
  "settingsHelpMovingBody": "On the old phone: Settings → “Send to another phone”. On the new one: Settings → “Receive from another phone”, and point the camera at the screen.\n\nLonger histories take a few codes, which change on their own; the new phone collects them in any order. No internet is involved — one phone shows, the other looks.",
  "@settingsHelpMovingBody": {
    "description": "A topic on the \"How Ebb works\" help screen. Words in quotation marks name buttons and settings elsewhere in the app: use exactly the same translation as those."
  },
  "settingsHelpSomeoneElseTitle": "Tracking someone else",
  "settingsHelpSomeoneElseBody": "Helping someone else keep track — a child who’s just starting, say? Settings → “Track someone else too”, and give them a name. A nickname or initial is fine.\n\nTap the name at the top of the home screen to switch between people. Everyone has their own reminders, which start off for people you add. The fertile window is only ever offered for you.",
  "@settingsHelpSomeoneElseBody": {
    "description": "A topic on the \"How Ebb works\" help screen. Words in quotation marks name buttons and settings elsewhere in the app: use exactly the same translation as those."
  },
  "settingsHelpHandoverTitle": "Handing someone over",
  "settingsHelpHandoverBody": "When someone you track gets their own phone: “Send to another phone”, and choose just them. On their phone, “Receive from another phone”. On a fresh install their history simply becomes theirs.\n\nAfterwards Ebb asks whether to remove them from your phone. It never does that on its own.",
  "@settingsHelpHandoverBody": {
    "description": "A topic on the \"How Ebb works\" help screen. Words in quotation marks name buttons and settings elsewhere in the app: use exactly the same translation as those."
  },
  "settingsHelpDeletingTitle": "Deleting",
  "settingsHelpDeletingBody": "Settings → “Delete all data” erases everything on this phone at once.\n\nTo remove one person you’ve added, open their settings and choose “Remove … from this phone”. Nobody else’s history is touched.",
  "@settingsHelpDeletingBody": {
    "description": "A topic on the \"How Ebb works\" help screen. Words in quotation marks name buttons and settings elsewhere in the app: use exactly the same translation as those."
  },
